# OpenRouter AI Gateway API Key
# Get key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Preferred Model Selection (Default: anthropic/claude-3.5-sonnet)
# Options: anthropic/claude-3.5-sonnet | openai/gpt-4o-mini | openai/gpt-4o | google/gemini-2.5-flash
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Access Gate Admin Passcode (Default: citemed2026)
ADMIN_ACCESS_KEY=citemed2026

# App Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3001
